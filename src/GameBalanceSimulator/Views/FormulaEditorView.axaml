<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GameBalanceSimulator.Views.FormulaEditorView"
             xmlns:vm="using:GameBalanceSimulator.ViewModels.ViewModels"
             xmlns:scottplot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             xmlns:formulas="using:GameBalanceSimulator.Core.Formulas"
             x:DataType="vm:FormulaEditorViewModel">
  <Grid RowDefinitions="Auto,*,*">
    <StackPanel Grid.Row="0" Spacing="4" Margin="8">
      <TextBlock Text="{DynamicResource FormulaEditor_Title}"
                 FontWeight="Bold"
                 FontSize="16" />
      <TextBlock Text="{DynamicResource FormulaEditor_SelectedFormula}" />
      <ComboBox ItemsSource="{Binding AvailableFormulas}"
                SelectedItem="{Binding SelectedFormula}"
                DisplayMemberBinding="{Binding Name}" />
      <TextBlock Text="{Binding SelectedFormulaDescription}"
                 TextWrapping="Wrap"
                 FontSize="12"
                 Opacity="0.8" />
      <ItemsControl ItemsSource="{Binding Parameters}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="formulas:FormulaParameter">
            <StackPanel Margin="0 4 0 0">
              <TextBlock Text="{Binding Name}" />
              <NumericUpDown Value="{Binding Value}"
                             Minimum="{Binding Minimum}"
                             Maximum="{Binding Maximum}"
                             Increment="{Binding Increment}"
                             FormatString="0.##" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid ColumnDefinitions="*,*,*">
        <StackPanel Grid.Column="0" Margin="0 0 4 0">
          <TextBlock Text="{DynamicResource FormulaEditor_DefenseMin}" />
          <NumericUpDown Value="{Binding DefenseMin}" Increment="1" Minimum="0" FormatString="0.##" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="4 0 4 0">
          <TextBlock Text="{DynamicResource FormulaEditor_DefenseMax}" />
          <NumericUpDown Value="{Binding DefenseMax}" Increment="1" Minimum="0" FormatString="0.##" />
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="4 0 0 0">
          <TextBlock Text="{DynamicResource FormulaEditor_DefenseStep}" />
          <NumericUpDown Value="{Binding DefenseStep}" Increment="1" Minimum="0.1" FormatString="0.##" />
        </StackPanel>
      </Grid>
      <Button Content="{DynamicResource FormulaEditor_GenerateCurve}"
              Command="{Binding GenerateCurvesCommand}" />
    </StackPanel>

    <Border Grid.Row="1" Margin="8">
      <scottplot:AvaPlot x:Name="DamagePlot" />
    </Border>

    <Border Grid.Row="2" Margin="8">
      <scottplot:AvaPlot x:Name="TtkPlot" />
    </Border>
  </Grid>
</UserControl>
